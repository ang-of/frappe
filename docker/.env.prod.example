# Copy to .env.prod and fill in real values. Never commit .env.prod.
# Tag for the lms image: where `docker compose ... build` tags a local build,
# and what `docker compose ... pull` fetches when you build elsewhere (e.g.
# Cloud Build) instead of on this host. Must be a registry this host can pull
# from, e.g. an Artifact Registry repo: `gcloud auth configure-docker
# <region>-docker.pkg.dev` once, then the VM's service account needs
# roles/artifactregistry.reader on that repo.
LMS_IMAGE=europe-west4-docker.pkg.dev/YOUR_PROJECT_ID/lms/lms:latest
SITE_NAME=lms.example.com
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Must be the same value as DB_ROOT_PASSWORD above (the mariadb image reads
# this exact name; cloudrun-entrypoint.sh reads DB_ROOT_PASSWORD).
MYSQL_ROOT_PASSWORD=change-me-too
ADMIN_PASSWORD=change-me-as-well
# Domain Caddy issues the Let's Encrypt cert for. Should match SITE_NAME.
CADDY_DOMAIN=lms.example.com
